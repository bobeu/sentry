# Celo mainnet private key that will mint the ERC-8004 agent NFT (with 0x prefix)
PRIVATE_KEY=

# Optional: override agent payTo / wallet advertised in metadata
AGENT_WALLET_ADDRESS=0xa1f70ffA4322E3609dD905b41f17Bf3913366bC1

# Optional: DeFAI attribution tag (defaults to Sentry's registered tag)
ATTRIBUTION_TAG=celo_e3cc4c8d8a0e

# Optional: hosted registration JSON URL. If empty, script embeds metadata as a data: URI
# AGENT_URI=https://raw.githubusercontent.com/bobeu/sentry/main/agent/registration.json

# Optional: custom RPC
# CELO_RPC_URL=https://forno.celo.org

# Set to true to prepare calldata without broadcasting
# DRY_RUN=true
