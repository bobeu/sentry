generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EmploymentStatus {
  Inactive
  Active
  Paused
  Exhausted
}

enum ActionType {
  mention_reply
  welcome
  faq_answer
  spam_moderation
  daily_summary
  mention_notification
  shift_handover
  escalation
  playbook_learn
  intent_signal
  incident_mode
  member_memory
  agent_task
  proof_report
  admin_moderation
  rose_relay
  announcement
  birthday
  secretary_reply
  secretary_escalation
  engagement_activity
  reward_payout
  points_award
}

enum AnnouncementStatus {
  scheduled
  posted
  cancelled
  failed
}

enum ActionStatus {
  completed
  failed
}

enum EscalationStatus {
  pending
  approved
  edited
  ignored
  expired
}

enum IncidentStatus {
  open
  monitoring
  resolved
}

enum ReportKind {
  daily
  shift
  proof
  work
}

enum PlaybookSource {
  correction
  manual
}

model User {
  id                       String   @id @default(cuid())
  email                    String   @unique
  withdrawalAddress        String?
  pendingWithdrawalAddress String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  wallet          Wallet?
  employment      Employment?
  groupLinks      GroupEmployment[]
  billingRecords  BillingRecord[]
  reports         Report[]
  settings        Settings?
  sessions        Session[]
  actions         ActionRecord[]
  settlements     Settlement[]
  withdrawals     Withdrawal[]
  playbookRules        PlaybookRule[]
  escalations          Escalation[]
  agentApiKeys         AgentApiKey[]
  businessConnections  BusinessConnectionRecord[]
  announcements        GroupAnnouncement[]
  rewardAccounts       RewardAccount[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Wallet {
  id              String    @id @default(cuid())
  address         String    @unique
  balance         Decimal   @default(0) @db.Decimal(36, 18)
  balanceCachedAt DateTime?
  identityHash    String?
  walletCurrency  String    @default("USDm")
  walletStatus    String    @default("Provisioning")
  provider        String    @default("employment-contract")
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  settlements Settlement[]
  withdrawals Withdrawal[]
}

model TelegramGroup {
  id               String    @id @default(cuid())
  telegramId       String    @unique
  name             String?
  /// JSON array of admin telegram user ids when obtainable — not assumed ownership.
  adminTelegramIds String?
  memberCount      Int?
  description      String?
  purpose          String?
  rules            String?
  botStatus        String    @default("unknown")
  botCanDelete     Boolean?
  botCanRestrict   Boolean?
  botCanBan        Boolean?
  lastBotEventAt   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tasks        Task[]
  settings     GroupSettings?
  employment   GroupEmployment[]
  faqs         GroupFAQ[]
  knowledgeSources GroupKnowledgeSource[]
  knowledgeChunks  GroupKnowledgeChunk[]
  messages     ConversationContext[]
  actions      ActionRecord[]
  reports      Report[]
  playbookRules PlaybookRule[]
  escalations  Escalation[]
  memberMemories MemberMemory[]
  incidents    IncidentEvent[]
  announcements GroupAnnouncement[]
  birthdays    MemberBirthday[]
  rewardAccount RewardAccount?
  memberPoints MemberPoints[]
  engagementActivities EngagementActivity[]
  rewardLedgers RewardLedger[]
}

model GroupSettings {
  id                    String        @id @default(cuid())
  groupId               String        @unique
  group                 TelegramGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  enabled               Boolean       @default(false)
  welcomeMembers        Boolean       @default(true)
  replyToMentions       Boolean       @default(true)
  answerQuestions       Boolean       @default(true)
  spamModeration        Boolean       @default(true)
  mentionNotifications  Boolean       @default(true)
  dailySummaryHour      Int           @default(9)
  summaryToGroup        Boolean       @default(true)
  summaryToAdmins       Boolean       @default(true)
  summaryToPrivate      Boolean       @default(true)
  /// Additive agent capacity flags
  shiftHandover         Boolean       @default(true)
  escalationLadder      Boolean       @default(true)
  livingPlaybook        Boolean       @default(true)
  intentSensing         Boolean       @default(true)
  proofOfWork           Boolean       @default(true)
  incidentMode          Boolean       @default(true)
  memberMemoryEnabled   Boolean       @default(false)
  hireInTelegram        Boolean       @default(true)
  /// Persona / org-chart (applied only when role != default)
  personaRole           String        @default("default")
  personaTone           String?
  /// Native ban/mute + optional Rose relay
  adminModeration       Boolean       @default(true)
  roseRelayEnabled      Boolean       @default(false)
  roseBotUsername       String        @default("MissRose_bot")
  announcementsEnabled  Boolean       @default(true)
  birthdaysEnabled      Boolean       @default(true)
  birthdayHourUtc       Int           @default(9)
  /// Employer-authored spam listening guide (phrases, media policy, examples).
  spamGuidelines        String?
  /// Employer work-report cadence in hours (default 24). Scheduler checks hourly.
  workReportIntervalHours Int         @default(24)
  lastWorkReportAt      DateTime?
  /// Engagement / liveliness flags (employer-configurable).
  allowGames            Boolean       @default(false)
  allowPolls            Boolean       @default(false)
  allowFun              Boolean       @default(false)
  allowComics           Boolean       @default(false)
  allowSocialCampaigns  Boolean       @default(false)
  /// Free-text guidance for games / learn-and-earn Sentry should invent.
  engagementGuidelines  String?
  /// Soft prompt cadence for offering fun (hours). 0 = never auto-offer.
  funPromptIntervalHours Int          @default(48)
  lastFunPromptAt       DateTime?
  /// Friendly humor / comedy vibes in group chat (employer-configurable).
  humorEnabled          Boolean       @default(true)
  /// friendly | witty | wholesome | off
  humorStyle            String        @default("friendly")
  /// When true, native Telegram polls are anonymous. Default: public (non-anonymous).
  pollsAnonymous        Boolean       @default(false)
  /// When true, members (not only employer/admins) may start polls/games if the type is enabled.
  membersCanStartActivities Boolean   @default(true)
  /// Optional URL/doc the employer supplies for generating polls/quizzes (else LLM defaults).
  engagementSourceUrl   String?
  /// Cash rewards for points (paid from RewardAccount, not employment wallet).
  rewardEnabled         Boolean       @default(false)
  rewardPaused          Boolean       @default(false)
  rewardAmountPerPoint  Decimal       @default(0) @db.Decimal(18, 8)
  rewardCurrency        String        @default("USDm")
  pointsPerCorrect      Int           @default(10)
  pointsPerPoll         Int           @default(5)
  pointsPerGame         Int           @default(15)
  pointsPerSocial       Int           @default(20)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
}

model GroupEmployment {
  id        String        @id @default(cuid())
  userId    String
  groupId   String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  group     TelegramGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// User who enabled Sentry for this group.
  enabled   Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([userId, groupId])
}

model GroupFAQ {
  id        String        @id @default(cuid())
  groupId   String
  group     TelegramGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  question  String
  answer    String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([groupId])
}

enum KnowledgeSourceType {
  url
  file
}

enum KnowledgeSourceStatus {
  pending
  ready
  failed
}

/// Employer-supplied docs / FAQ pages / blogs Sentry can search when answering.
model GroupKnowledgeSource {
  id          String                @id @default(cuid())
  groupId     String
  group       TelegramGroup         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  type        KnowledgeSourceType
  title       String?
  url         String?
  fileName    String?
  mimeType    String?
  /// Full extracted plain text (capped on ingest).
  contentText String                @default("")
  byteSize    Int                   @default(0)
  status      KnowledgeSourceStatus @default(pending)
  error       String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  chunks      GroupKnowledgeChunk[]

  @@index([groupId])
  @@index([groupId, status])
}

model GroupKnowledgeChunk {
  id        String               @id @default(cuid())
  groupId   String
  group     TelegramGroup        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sourceId  String
  source    GroupKnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  ordinal   Int
  content   String
  createdAt DateTime             @default(now())

  @@index([groupId])
  @@index([sourceId])
}

model ConversationContext {
  id                String        @id @default(cuid())
  groupId           String
  group             TelegramGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  telegramMessageId String
  fromUserId        String?
  fromUsername      String?
  text              String
  createdAt         DateTime      @default(now())

  @@unique([groupId, telegramMessageId])
  @@index([groupId, createdAt])
  @@index([createdAt])
}

enum ChargeStatus {
  pending
  succeeded
  failed
  refunded
}

enum SettlementStatus {
  pending
  submitted
  succeeded
  failed
}

enum WithdrawalStatus {
  pending
  submitted
  succeeded
  failed
}

model ActionRecord {
  id           String         @id @default(cuid())
  type         ActionType
  groupId      String?
  group        TelegramGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  userId       String?
  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  completedAt  DateTime       @default(now())
  status       ActionStatus   @default(completed)
  billable     Boolean        @default(true)
  metadata     Json?
  settlementId String?
  settlement   Settlement?    @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now())
  charge       ChargeRecord?

  @@index([userId, completedAt])
  @@index([groupId, completedAt])
  @@index([completedAt])
  @@index([settlementId])
}

model ChargeRecord {
  id              String       @id @default(cuid())
  actionRecordId  String       @unique
  actionRecord    ActionRecord @relation(fields: [actionRecordId], references: [id], onDelete: Cascade)
  amount          Decimal      @db.Decimal(36, 18)
  currency        String       @default("USDm")
  status          ChargeStatus @default(pending)
  transactionHash String?
  failureReason   String?
  createdAt       DateTime     @default(now())

  @@index([createdAt])
  @@index([status])
}

model Settlement {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletId        String
  wallet          Wallet           @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount          Decimal          @db.Decimal(36, 18)
  settlementFee   Decimal          @db.Decimal(36, 18)
  currency        String           @default("USDm")
  actionCount     Int
  transactionHash String?
  status          SettlementStatus @default(pending)
  failureReason   String?
  createdAt       DateTime         @default(now())
  completedAt     DateTime?
  actions         ActionRecord[]

  @@index([userId, createdAt])
  @@index([status])
}

model PaymentCurrencyConfig {
  currency     String   @id
  enabled      Boolean  @default(true)
  tokenAddress String?
  updatedAt    DateTime @updatedAt
}

model Withdrawal {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletId        String
  wallet          Wallet           @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount          Decimal          @db.Decimal(36, 18)
  currency        String
  destination     String
  transactionHash String?
  status          WithdrawalStatus @default(pending)
  failureReason   String?
  createdAt       DateTime         @default(now())
  completedAt     DateTime?

  @@index([userId, createdAt])
  @@index([status])
}

model Employment {
  id                 String           @id @default(cuid())
  userId             String           @unique
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status             EmploymentStatus @default(Inactive)
  outstandingCharges Decimal          @default(0) @db.Decimal(36, 18)
  lastSettlementAt   DateTime?
  startedAt          DateTime?
  pausedAt           DateTime?
  /// Version string of the Employment Agreement last accepted at hire.
  agreementVersion   String?
  agreementAcceptedAt DateTime?
  agreementRejectedAt DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model Task {
  id        String         @id @default(cuid())
  groupId   String?
  group     TelegramGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model BillingRecord {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Decimal  @default(0)
  createdAt DateTime @default(now())
}

model Report {
  id        String         @id @default(cuid())
  userId    String?
  user      User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId   String?
  group     TelegramGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  content   String?
  kind      ReportKind     @default(daily)
  createdAt DateTime       @default(now())

  @@index([userId, kind, createdAt])
  @@index([groupId, kind, createdAt])
}

model Settings {
  id                 String   @id @default(cuid())
  userId             String?  @unique
  user               User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName        String?
  timeZone           String   @default("UTC")
  autoResume         Boolean  @default(true)
  emailNotifications Boolean  @default(true)
  /// Telegram identity for private mention notifications
  telegramUserId     String?
  telegramUsername   String?
  /// Allow agent task API once keys exist
  agentApiEnabled    Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model PlaybookRule {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId     String?
  group       TelegramGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  trigger     String
  instruction String
  source      PlaybookSource @default(manual)
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([userId, active])
  @@index([groupId, active])
}

model Escalation {
  id                   String           @id @default(cuid())
  groupId              String
  group                TelegramGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId               String
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status               EscalationStatus @default(pending)
  draftText            String
  reason               String?
  sourceTelegramMsgId  String?
  sourceChatId         String?
  employerTelegramMsgId String?
  finalText            String?
  createdAt            DateTime         @default(now())
  resolvedAt           DateTime?

  @@index([userId, status, createdAt])
  @@index([groupId, status])
}

model MemberMemory {
  id             String        @id @default(cuid())
  groupId        String
  group          TelegramGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  telegramUserId String
  note           String
  consentAt      DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([groupId, telegramUserId])
  @@index([telegramUserId])
}

model IncidentEvent {
  id        String         @id @default(cuid())
  groupId   String
  group     TelegramGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  trigger   String
  status    IncidentStatus @default(open)
  timeline  Json?
  createdAt DateTime       @default(now())
  resolvedAt DateTime?

  @@index([groupId, status, createdAt])
}

model AgentApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String
  keyHash    String    @unique
  keyPrefix  String
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, revokedAt])
}

/// Telegram Secretary / Business connection (user linked Sentry to their account).
model BusinessConnectionRecord {
  id             String   @id @default(cuid())
  connectionId   String   @unique
  userTelegramId String
  userChatId     String
  canReply       Boolean  @default(false)
  isEnabled      Boolean  @default(true)
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  rightsJson     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userTelegramId])
  @@index([userId, isEnabled])
}

model GroupAnnouncement {
  id          String             @id @default(cuid())
  groupId     String
  group       TelegramGroup      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  text        String
  status      AnnouncementStatus @default(scheduled)
  scheduledAt DateTime?
  postedAt    DateTime?
  error       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([groupId, status, scheduledAt])
  @@index([status, scheduledAt])
}

model MemberBirthday {
  id             String        @id @default(cuid())
  groupId        String
  group          TelegramGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  telegramUserId String
  month          Int
  day            Int
  displayName    String?
  consentAt      DateTime      @default(now())
  lastCelebratedYear Int?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([groupId, telegramUserId])
  @@index([month, day])
}

enum RewardAccountStatus {
  Provisioning
  Active
  Paused
  Archived
}

enum EngagementActivityType {
  poll
  game
  learn
  social
  comic
  fun
}

enum EngagementActivityStatus {
  draft
  active
  closed
  cancelled
}

enum RewardLedgerKind {
  award_points
  reset_points
  update_points
  payout
  payout_failed
  accumulate
}

enum RewardLedgerStatus {
  pending
  sent
  failed
  cancelled
}

/// On-chain RewardAccount (RewardFactory) linked to a Telegram group.
model RewardAccount {
  id              String              @id @default(cuid())
  groupId         String              @unique
  group           TelegramGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// Employer who requested creation (manages via Sentry, not direct on-chain access).
  ownerUserId     String
  owner           User                @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  address         String
  accountKey      String              @unique
  currency        String              @default("USDm")
  status          RewardAccountStatus @default(Provisioning)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  ledgers RewardLedger[]

  @@index([ownerUserId])
}

model MemberPoints {
  id               String        @id @default(cuid())
  groupId          String
  group            TelegramGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  telegramUserId   String
  username         String?
  points           Int           @default(0)
  lifetimePoints   Int           @default(0)
  /// Cash reward accrued but not yet paid on-chain (wallet currency units).
  pendingReward    Decimal       @default(0) @db.Decimal(18, 8)
  lifetimeRewarded Decimal       @default(0) @db.Decimal(18, 8)
  payoutAddress    String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([groupId, telegramUserId])
  @@index([groupId, points])
}

model EngagementActivity {
  id              String                   @id @default(cuid())
  groupId         String
  group           TelegramGroup            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  type            EngagementActivityType
  status          EngagementActivityStatus @default(active)
  title           String
  description     String?
  /// JSON config: poll options, quiz answer, social URL, etc.
  configJson      String                   @default("{}")
  pointsReward    Int                      @default(10)
  telegramPollId  String?
  telegramMsgId   String?
  createdByUserId String?
  closesAt        DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  submissions ActivitySubmission[]

  @@index([groupId, status, type])
}

model ActivitySubmission {
  id             String             @id @default(cuid())
  activityId     String
  activity       EngagementActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  telegramUserId String
  username       String?
  payload        String
  verified       Boolean            @default(false)
  pointsAwarded  Int                @default(0)
  notes          String?
  createdAt      DateTime           @default(now())

  @@unique([activityId, telegramUserId])
  @@index([telegramUserId])
}

model RewardLedger {
  id               String             @id @default(cuid())
  groupId          String
  group            TelegramGroup      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  rewardAccountId  String?
  rewardAccount    RewardAccount?     @relation(fields: [rewardAccountId], references: [id], onDelete: SetNull)
  telegramUserId   String
  kind             RewardLedgerKind
  status           RewardLedgerStatus @default(pending)
  pointsDelta      Int                @default(0)
  amount           Decimal            @default(0) @db.Decimal(18, 8)
  currency         String             @default("USDm")
  payoutId         String?            @unique
  destination      String?
  txHash           String?
  failureReason    String?
  metaJson         String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([groupId, telegramUserId, status])
  @@index([status, kind])
}
