# Runtime (pooled) connection — used by Prisma Client + PrismaPg adapter
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
# Direct connection for migrations/CLI — for Prisma Postgres, mirror DATABASE_URL unless a separate direct URL is provided
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
TELEGRAM_BOT_TOKEN=
# Optional: shared secret for Telegram webhook header x-telegram-bot-api-secret-token
TELEGRAM_WEBHOOK_SECRET=
# Optional Twitter API bearer for deeper social-campaign verification
# TWITTER_BEARER_TOKEN=
CELO_RPC=https://forno.celo.org
# Public HTTPS origin of the deployed app (used for Telegram webhook)
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_CHAIN_ID=42220

# Manager-controlled custody contracts (after deploy + sync)
SENTRY_OPERATOR_KEY=
SENTRY_OWNER_KEY=
SENTRY_TREASURY_ADDRESS=
EMPLOYMENT_MANAGER_ADDRESS=
SENTRY_WALLET_FACTORY_ADDRESS=
# Optional override after RewardFactory deploy (otherwise uses synced addresses.json)
# REWARD_FACTORY_ADDRESS=

# Celo Mainnet stablecoin addresses (configure for production)
CELO_USDM_ADDRESS=
CELO_USDC_ADDRESS=
CELO_USDT_ADDRESS=

# Comma-separated admin emails for /admin/payment
ADMIN_EMAILS=

# Scale pricing down 100x for judge demos (e.g. 0.01 → 0.0001)
DEMO_MODE=false

# Settlement thresholds (prepaid batch billing)
SETTLEMENT_MODE=instant
# instant = one on-chain chargeSettlement per billable action (max DeFAI volume)
# batch   = accumulate until monetary/action/time thresholds (lower gas)
SETTLEMENT_MONETARY_THRESHOLD=0.50
SETTLEMENT_ACTION_THRESHOLD=5
SETTLEMENT_INTERVAL_MINUTES=15
SETTLEMENT_FEE_ESTIMATE=0.001
SETTLEMENT_FEE_BUFFER_PERCENT=10
SETTLEMENT_ESTIMATE_GAS=true
