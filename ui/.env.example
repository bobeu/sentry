# Settlement thresholds (prepaid batch billing)
SETTLEMENT_MONETARY_THRESHOLD=0.50
SETTLEMENT_ACTION_THRESHOLD=5
SETTLEMENT_INTERVAL_MINUTES=15
SETTLEMENT_FEE_ESTIMATE=0.001
SETTLEMENT_FEE_BUFFER_PERCENT=10
