{
  "name": "sentry",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "postinstall": "prisma generate",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "prisma:validate": "prisma validate",
    "bot:poll": "tsx telegram/poll.ts",
    "scheduler": "tsx scripts/run-scheduler.ts",
    "test": "tsx --test tests/backend.test.ts",
    "start:all": "pnpm prisma:generate && pnpm prisma:deploy && pnpm dev",
    "start:dev": "pnpm prisma:generate && pnpm prisma:migrate && pnpm dev",
    "start:prod": "pnpm prisma:deploy && pnpm start"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@prisma/client-runtime-utils": "^7.8.0",
    "dotenv": "^17.2.1",
    "next": "^15.3.3",
    "node-cron": "^3.0.3",
    "pg": "^8.16.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "telegraf": "^4.16.3",
    "viem": "^2.31.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.10",
    "@types/node": "^22.15.32",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.29.0",
    "eslint-config-next": "^15.3.3",
    "prettier": "^3.5.3",
    "prisma": "7.8.0",
    "tailwindcss": "^4.1.10",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
