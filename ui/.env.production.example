# Set these values in the deployment platform's secret manager. Do not commit a real .env.production file.
# Prisma Postgres example: get both generated URLs from Prisma Console > Connect.
DATABASE_URL="postgres://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require"
DIRECT_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"

# DATABASE_URL is for the running Next.js application and workers (prefer pooled.db.prisma.io).
# DIRECT_URL is used by `prisma migrate deploy` in the Vercel build step (db.prisma.io).
# Add all non-database secrets listed in .env.example in the Vercel project settings.
# Build script: prisma generate && prisma migrate deploy && next build