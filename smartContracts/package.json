{
  "name": "sentry-smartcontracts",
  "license": "MIT",
  "version": "0.1.0",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "deploy": "hardhat deploy --network hardhat",
    "deploy-celo": "hardhat deploy --network celo && node sync-data.js",
    "deploy-goat-testnet": "hardhat deploy --network goatTestnet3 && node sync-data.js",
    "deploy-goat": "hardhat deploy --network goat && node sync-data.js",
    "sync": "node sync-data.js",
    "clean": "hardhat clean",
    "tsc": "bunx tsc -p . && cp typechain/*.d.ts dist/typechain/",
    "build": "bun run compile && bun run tsc",
    "ensure:register": "tsx tests/ensureRegisterEmployment.ts",
    "ensure:charge": "tsx tests/ensureChargeSettlement.ts",
    "ensure:withdraw": "tsx tests/ensureWithdraw.ts",
    "ensure:fund": "tsx tests/ensureFundAccount.ts",
    "ensure:reward-account": "tsx tests/ensureRewardAccount.ts",
    "ensure:payout-reward": "tsx tests/ensurePayoutReward.ts",
    "ensure:withdraw-reward": "tsx tests/ensureWithdrawRewardToEmployer.ts"
  },
  "dependencies": {
    "@celo/attribution-tags": "^0.3.0",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomiclabs/hardhat-web3": "^2.0.0",
    "@openzeppelin/contracts": "^5.0.2",
    "dotenv": "^17.2.1",
    "hardhat": "^2.22.17",
    "hardhat-deploy": "^0.12.4",
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.7",
    "@nomicfoundation/hardhat-ethers": "^3.0.7",
    "@nomicfoundation/hardhat-ignition": "^0.15.0",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.0",
    "@nomicfoundation/hardhat-ignition-viem": "^0.15.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.0",
    "@nomicfoundation/hardhat-toolbox-viem": "^3.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.0",
    "@nomicfoundation/hardhat-viem": "^2.0.0",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.2.0",
    "@types/chai-as-promised": "^7.1.6",
    "@types/mocha": ">=9.1.0",
    "@types/node": ">=18.0.0",
    "chai": "^4.2.0",
    "ethers": "^6.13.7",
    "hardhat-gas-reporter": "^1.0.8",
    "solidity-coverage": "^0.8.0",
    "ts-node": ">=8.0.0",
    "typechain": "^8.3.2",
    "typescript": "~5.0.4",
    "viem": "^2.52.2"
  },
  "author": "Bobeu"
}
